{
  "name": "dsh-hos-scrcpy",
  "version": "1.0.0",
  "description": "DSH 鸿蒙投屏控制插件（静态 npm 包版 v2）：设备发现 / 实时投屏 / 触控操作 / 系统按键 / hilog 日志 / AI 截图识别",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "files": [
    "lib",
    "client",
    "resources",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "keywords": [
    "dsh",
    "cordis",
    "scrcpy",
    "harmonyos",
    "hdc"
  ],
  "license": "MIT"
}
